{
  "name": "olive-branch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "node server/developmentServer.mjs",
    "security:check": "node scripts/check-public-secrets.mjs",
    "build": "npm run security:check && npm run qr:generate && tsc -b && vite build",
    "qr:generate": "node scripts/generate-download-qr.mjs",
    "postinstall": "npm run build",
    "start": "node server/productionServer.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "firebase": "^13.1.0",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.62.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
