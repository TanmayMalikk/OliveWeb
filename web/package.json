{
  "name": "olive-branch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "node server/developmentServer.mjs",
    "security:check": "node scripts/check-public-secrets.mjs",
    "build": "npm run security:check && npm run qr:generate && tsc -b && vite build",
    "qr:generate": "node scripts/generate-download-qr.mjs",
    "postinstall": "npm run build",
    "start": "node server/productionServer.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "node scripts/browser-coverage.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@serenity-kit/opaque": "^1.1.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "firebase": "^13.2.0",
    "idb": "^8.0.4",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.71.0",
    "mapbox-gl": "3.35.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "istanbul-lib-coverage": "^3.2.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
