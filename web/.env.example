# Leave empty to use encrypted, browser-only local accounts. Never paste server keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key used by Firebase App Check in production.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Optional Firebase emulators. Use a separate demo project ID; never production credentials.
VITE_USE_FIREBASE_EMULATORS=false
# Production download build: stable public object replaced after every main build.
# VITE_ANDROID_DOWNLOAD_URL=https://firebasestorage.googleapis.com/v0/b/PROJECT.firebasestorage.app/o/public%2Fandroid%2Folive-branch.apk?alt=media
# Server environment (set in your shell when starting npm run dev/start):
# ANDROID_APK_PATH=C:/absolute/path/to/a/signed-release.apk
# ANDROID_APK_LABEL="Development build for local university testing"
# PUBLIC_ORIGIN=http://your-computers-LAN-IP:5173
# HOST=0.0.0.0
# LAN HTTP supports APK downloads only. Use trusted HTTPS for PWA/Web Crypto on a phone.
