rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    function signedIn() { return request.auth != null; }

    function validMessageUsername(username) {
      return username is string && username.matches('[a-z0-9_]{4,24}');
    }

    function validMessagingEmail(username) {
      return request.auth.token.email == username + '@users.olive.invalid'
        || request.auth.token.email == username + '@safe.olive.invalid';
    }

    function contactAt(c, i) {

      return c.size() <= i || (c[i] is map && c[i].keys().hasOnly(['id','name','phone','details','safeToStay'])

        && c[i].id is string && c[i].id.size() <= 64

        && c[i].name is string && c[i].name.size() > 0 && c[i].name.size() <= 120

        && (!('phone' in c[i]) || (c[i].phone is string && c[i].phone.size() <= 40))

        && (!('safeToStay' in c[i]) || c[i].safeToStay is bool)

        && c[i].details is string && c[i].details.size() > 0 && c[i].details.size() <= 200);

    }

    function validAddress(a) {

      return a is map && a.keys().hasAll(['line1','line2','city','province','postalCode','country'])

        && a.keys().hasOnly(['line1','line2','city','province','postalCode','country'])

        && a.line1 is string && a.line1.size() <= 160

        && a.line2 is string && a.line2.size() <= 160

        && a.city is string && a.city.size() <= 160

        && a.province is string && a.province.size() <= 160

        && a.postalCode is string && a.postalCode.size() <= 160

        && a.country is string && a.country.size() <= 160;

    }

    function validProfile(p) {

      return p.keys().hasAll(['username','fullName','affectedNames','dob','language','situation','region','triggerHash','contacts'])

        && p.keys().hasOnly(['username','fullName','affectedNames','abuserName','dob','language','situation','region','triggerHash','contacts','address','role','coverType','cover_app','email','phone'])

        && p.username is string && p.username.matches('[a-z0-9_]{3,30}')

        && validMessagingEmail(p.username)

        && p.fullName is string && p.fullName.size() > 0 && p.fullName.size() <= 120

        && p.affectedNames is string && p.affectedNames.size() <= 500

        && p.dob is string && p.dob.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')

        && p.language is string && p.language.size() > 0 && p.language.size() <= 60

        && p.situation is string && p.situation.size() <= 2000

        && p.region is string && p.region.size() <= 200

        && p.triggerHash is string
        && (p.triggerHash.matches('[a-f0-9]{64}') || (('role' in p) && p.role in ['SAFE_CONTACT','STAFF','ADMIN'] && p.triggerHash == ''))

        && (!('role' in p) || p.role in ['USER','SAFE_CONTACT','STAFF','ADMIN'])

        && (!('cover_app' in p) || p.cover_app is string)

        && (!('address' in p) || validAddress(p.address))

        && p.contacts is list && p.contacts.size() <= 25

        && contactAt(p.contacts,0) && contactAt(p.contacts,1) && contactAt(p.contacts,2)

        && contactAt(p.contacts,3) && contactAt(p.contacts,4) && contactAt(p.contacts,5)

        && contactAt(p.contacts,6) && contactAt(p.contacts,7) && contactAt(p.contacts,8)

        && contactAt(p.contacts,9) && contactAt(p.contacts,10) && contactAt(p.contacts,11)

        && contactAt(p.contacts,12) && contactAt(p.contacts,13) && contactAt(p.contacts,14)

        && contactAt(p.contacts,15) && contactAt(p.contacts,16) && contactAt(p.contacts,17)

        && contactAt(p.contacts,18) && contactAt(p.contacts,19) && contactAt(p.contacts,20)

        && contactAt(p.contacts,21) && contactAt(p.contacts,22) && contactAt(p.contacts,23)

        && contactAt(p.contacts,24);

    }

    match /users/{uid} {

      allow get: if owner(uid);

      allow list: if false;

      allow create: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.username.matches('[a-z0-9_]{8,24}');

      allow update: if owner(uid) && validProfile(request.resource.data)

        && request.resource.data.username == resource.data.username;

      allow delete: if owner(uid);

    }

    // File access lists can grant reads, but only the authenticated owner can create, edit, or delete metadata.
    match /files/{fileId} {
      function validFileMetadata(data, id) {
        return data.keys().hasOnly(['owner_id','storage_path','file_name','file_type','allowed_users','created_at'])
          && data.owner_id is string
          && data.storage_path == 'users/' + data.owner_id + '/media/' + id
          && data.file_name is string && data.file_name.size() <= 160
          && data.file_type is string && data.file_type.size() <= 120
          && data.allowed_users is list
          && data.allowed_users.size() > 0 && data.allowed_users.size() <= 25
          && data.allowed_users.hasAny([data.owner_id]);
      }
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && validFileMetadata(request.resource.data, fileId);
      allow read: if signedIn() && request.auth.uid in resource.data.allowed_users;
      allow update: if signedIn() && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.storage_path == resource.data.storage_path
        && validFileMetadata(request.resource.data, fileId);
      allow delete: if signedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /privateEntries/{entryId} {
      function validPrivateEntry(data) {
        return data.keys().hasOnly(['id','ownerUid','ciphertext','wrappedKeys','allowedUsers','createdAt','updatedAt'])
          && data.id == entryId
          && data.ownerUid is string
          && data.ciphertext is string && data.ciphertext.size() > 0
          && data.wrappedKeys is map
          && data.allowedUsers is list && data.allowedUsers.size() > 0 && data.allowedUsers.size() <= 25
          && data.allowedUsers.hasAny([data.ownerUid])
          && data.wrappedKeys.keys().hasAll(data.allowedUsers)
          && data.wrappedKeys.keys().hasOnly(data.allowedUsers);
      }
      allow read: if signedIn() && request.auth.uid in resource.data.allowedUsers;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid
        && validPrivateEntry(request.resource.data);
      allow update: if signedIn() && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validPrivateEntry(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // Username lookup is exact and case-normalized by the app; listing the directory is never allowed.
    match /messageDirectory/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if owner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid','username','publicKey','updatedAt'])
        && request.resource.data.username == username
        && request.resource.data.publicKey is string && request.resource.data.publicKey.size() > 0
        && request.resource.data.publicKey.size() <= 1000
        && validMessageUsername(username)
        && validMessagingEmail(username);
      allow delete: if owner(resource.data.uid);
    }

    function directoryMatches(uid, username) {
      return validMessageUsername(username)
        && get(/databases/$(database)/documents/messageDirectory/$(username)).data.uid == uid;
    }

    function pairIdMatches(pairId, firstUid, secondUid) {
      return pairId == firstUid + '--' + secondUid || pairId == secondUid + '--' + firstUid;
    }

    function validFriendRequest(data) {
      return data.keys().hasOnly(['senderUid','senderUsername','recipientUid','recipientUsername','friendshipId','createdAt'])
        && data.senderUid is string && data.recipientUid is string && data.senderUid != data.recipientUid
        && validMessageUsername(data.senderUsername) && validMessageUsername(data.recipientUsername)
        && pairIdMatches(data.friendshipId,data.senderUid,data.recipientUid)
        && directoryMatches(data.senderUid,data.senderUsername)
        && directoryMatches(data.recipientUid,data.recipientUsername);
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid
        && requestId == request.resource.data.senderUid + '--' + request.resource.data.recipientUid
        && validFriendRequest(request.resource.data)
        && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.recipientUid + '--' + request.resource.data.senderUid))
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.senderUid + '--' + request.resource.data.recipientUid))
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.recipientUid + '--' + request.resource.data.senderUid));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
    }

    function validFriendship(data, friendshipId) {
      return data.keys().hasOnly(['participantIds','participantUsernames','acceptedRequestId','createdAt'])
        && data.participantIds is list && data.participantIds.size() == 2
        && data.participantIds[0] != data.participantIds[1]
        && data.participantUsernames is map
        && data.participantUsernames[data.participantIds[0]] is string
        && data.participantUsernames[data.participantIds[1]] is string
        && directoryMatches(data.participantIds[0],data.participantUsernames[data.participantIds[0]])
        && directoryMatches(data.participantIds[1],data.participantUsernames[data.participantIds[1]])
        && pairIdMatches(friendshipId,data.participantIds[0],data.participantIds[1]);
    }

    function acceptedRequest(data) {
      return get(/databases/$(database)/documents/friendRequests/$(data.acceptedRequestId)).data;
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow list: if false;
      allow create: if signedIn() && validFriendship(request.resource.data,friendshipId)
        && acceptedRequest(request.resource.data).recipientUid == request.auth.uid
        && acceptedRequest(request.resource.data).friendshipId == friendshipId
        && acceptedRequest(request.resource.data).senderUid in request.resource.data.participantIds
        && acceptedRequest(request.resource.data).recipientUid in request.resource.data.participantIds
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.participantIds[1] + '--' + request.resource.data.participantIds[0]));
      allow update, delete: if false;
    }

    function friendshipAfter(friendshipId) {
      return getAfter(/databases/$(database)/documents/friendships/$(friendshipId)).data;
    }

    function validFriendListEntry(ownerUid, friendshipId, data) {
      return data.keys().hasOnly(['friendshipId','friendUid','friendUsername','createdAt'])
        && data.friendshipId == friendshipId && data.friendUid != ownerUid
        && ownerUid in friendshipAfter(friendshipId).participantIds
        && data.friendUid in friendshipAfter(friendshipId).participantIds
        && directoryMatches(data.friendUid,data.friendUsername)
        && acceptedRequest(friendshipAfter(friendshipId)).recipientUid == request.auth.uid;
    }

    match /friendLists/{ownerUid}/friends/{friendshipId} {
      allow get, list: if owner(ownerUid);
      allow create: if signedIn() && validFriendListEntry(ownerUid,friendshipId,request.resource.data);
      allow update, delete: if false;
    }

    function conversationParticipant(data) {
      return signedIn() && data.participantIds is list && request.auth.uid in data.participantIds;
    }

    function friendshipForConversation(data) {
      return getAfter(/databases/$(database)/documents/friendships/$(data.friendshipId)).data;
    }

    function validConversation(data, conversationId) {
      return data.keys().hasOnly(['friendshipId','participantIds','participantUsernames','createdAt','updatedAt','lastMessage','lastMessageId','lastSenderUid','roomKeys','participantPublicKeys'])
        && data.friendshipId == conversationId
        && data.lastMessage is string && data.lastMessage.size() <= 160
        && data.lastMessageId is string && data.lastMessageId.size() <= 128
        && (!data.keys().hasAny(['lastSenderUid'])
          || (data.lastSenderUid is string && data.lastSenderUid.size() <= 128))
        && existsAfter(/databases/$(database)/documents/friendships/$(data.friendshipId))
        && data.participantIds == friendshipForConversation(data).participantIds
        && data.participantUsernames == friendshipForConversation(data).participantUsernames;
    }

    function validConversationKeys(data) {
      return data.roomKeys is map && data.participantPublicKeys is map
        && data.roomKeys.keys().hasAll(data.participantIds) && data.roomKeys.keys().hasOnly(data.participantIds)
        && data.participantPublicKeys.keys().hasAll(data.participantIds)
        && data.participantPublicKeys.keys().hasOnly(data.participantIds)
        && data.roomKeys[data.participantIds[0]] is string && data.roomKeys[data.participantIds[0]].size() <= 1000
        && data.roomKeys[data.participantIds[1]] is string && data.roomKeys[data.participantIds[1]].size() <= 1000
        && data.participantPublicKeys[data.participantIds[0]] == get(/databases/$(database)/documents/messageDirectory/$(data.participantUsernames[data.participantIds[0]])).data.publicKey
        && data.participantPublicKeys[data.participantIds[1]] == get(/databases/$(database)/documents/messageDirectory/$(data.participantUsernames[data.participantIds[1]])).data.publicKey;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/friendships/$(conversationId)).data.participantIds;
      allow list: if false;
      allow create: if conversationParticipant(request.resource.data) && validConversation(request.resource.data,conversationId);
      allow update: if conversationParticipant(resource.data)
        && validConversation(request.resource.data,conversationId)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageId','lastSenderUid','updatedAt'])
          || (!resource.data.keys().hasAny(['roomKeys','participantPublicKeys'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomKeys','participantPublicKeys','updatedAt'])
            && validConversationKeys(request.resource.data))
        );
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if conversationParticipant(parentConversation());
        allow create: if conversationParticipant(parentConversation())
          && request.resource.data.keys().hasOnly(['senderUid','senderUsername','body','ciphertext','deleted','sentAt','clientSentAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUsername is string
          && validMessagingEmail(request.resource.data.senderUsername)
          && ((request.resource.data.body is string && request.resource.data.body.size() > 0
              && request.resource.data.body.size() <= 2000 && !request.resource.data.keys().hasAny(['ciphertext']))
            || (request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() > 0
              && request.resource.data.ciphertext.size() <= 12000 && !request.resource.data.keys().hasAny(['body'])))
          && request.resource.data.deleted == false
          && request.resource.data.clientSentAt is int;
        allow update: if conversationParticipant(parentConversation())
          && resource.data.senderUid == request.auth.uid
          && resource.data.deleted == false && request.resource.data.deleted == true
          && ((!resource.data.keys().hasAny(['ciphertext']) && request.resource.data.body == 'Message unsent')
            || (resource.data.keys().hasAny(['ciphertext']) && request.resource.data.ciphertext == 'Message unsent'))
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.senderUsername == resource.data.senderUsername
          && request.resource.data.sentAt == resource.data.sentAt
          && request.resource.data.clientSentAt == resource.data.clientSentAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','ciphertext','deleted','deletedAt']);
        allow delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }

  }

}

