// Contains the firestore code for this part of Olive.
rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model: files/{fileId}
    // ===============================================================
    // Legacy Firebase Storage record:
    // owner_id, storage_path, file_name, file_type, allowed_users, created_at.
    // OCR fields are intentionally forbidden because OCR output is private payload data.
    //
    // Encrypted R2 record (written only by trusted Cloud Functions):
    // owner_id, object_key, encrypted_metadata, wrapped_keys, allowed_users,
    // ciphertext_size, ciphertext_sha256, encryption_version, created_at.
    // encrypted_metadata contains the file name, MIME type, media kind, and optional OCR result.
    // ===============================================================
    // Assumed data model: syncInvalidations/{uid}
    // ===============================================================
    // Server-owned, payload-free reconciliation marker:
    // ownerUid: string equal to the document UID (required, immutable by virtue of client-write denial).
    // allowedUsers: single-item list containing only ownerUid (required).
    // revision, safetyRevision, mediaRevision, conversationRevision, accountRevision:
    // non-negative integers no larger than JavaScript's safe-integer maximum (required).
    // updatedAt: server timestamp (required).
    // Clients may read only their own valid marker. Only trusted Admin SDK code may write it.
    // ===============================================================

    // Web entry URLs are a discreet entry gate, never a replacement for account authentication.
    // Each authenticated owner may rotate their own token hash; anonymous lookups are forbidden.
    match /webEntryLinks/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokenHash','updatedAt'])
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.matches('[a-f0-9]{64}')
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    function signedIn() { return request.auth != null; }

    // Safety-plan listeners may read only the same owner, shared-contact, or assigned support plan as the callable API.
    match /safetyPlans/{ownerUid} {
      allow get: if signedIn() && (
        (request.auth.uid == ownerUid && request.auth.token.role == 'USER')
        || (request.auth.token.role == 'SAFE_CONTACT'
          && resource.data.safeContactUids is list
          && request.auth.uid in resource.data.safeContactUids)
        || (request.auth.token.role == 'STAFF'
          && resource.data.staffUid == request.auth.uid
          && resource.data.consultationRequested == true)
        || request.auth.token.role == 'ADMIN'
      );
      allow list: if false;
      // All plan edits still pass through the callable that validates field revisions and role access.
      allow create, update, delete: if false;
    }

    // Account sync markers contain no profile or note text; they only tell signed-in clients to reload Storage data.
    match /accountSync/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision','updatedAt'])
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validSyncRevision(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    function validSyncInvalidation(data, uid) {
      return data.keys().hasAll(['ownerUid','allowedUsers','revision','safetyRevision',
          'mediaRevision','conversationRevision','accountRevision','updatedAt'])
        && data.keys().hasOnly(['ownerUid','allowedUsers','revision','safetyRevision',
          'mediaRevision','conversationRevision','accountRevision','updatedAt'])
        && data.ownerUid is string && data.ownerUid == uid
        && data.allowedUsers is list && data.allowedUsers.size() == 1
        && data.allowedUsers[0] is string && data.allowedUsers[0] == uid
        && validSyncRevision(data.revision)
        && validSyncRevision(data.safetyRevision)
        && validSyncRevision(data.mediaRevision)
        && validSyncRevision(data.conversationRevision)
        && validSyncRevision(data.accountRevision)
        && data.updatedAt is timestamp;
    }

    // Priority sync markers contain no user payload. Server code owns every mutation so a client
    // cannot manufacture a revision, target another account, or use the collection as storage.
    match /syncInvalidations/{uid} {
      allow get: if owner(uid) && validSyncInvalidation(resource.data, uid);
      allow list, create, update, delete: if false;
    }

    function validMessageUsername(username) {
      return username is string && username.matches('[a-z0-9_]{4,24}');
    }

    function validMessagingEmail(username) {
      return request.auth.token.email == username + '@users.olive.invalid'
        || request.auth.token.email == username + '@safe.olive.invalid'
        || request.auth.token.email == username + '@staff.olive.invalid'
        || request.auth.token.email == username + '@admin.olive.invalid'
        || request.auth.token.role == 'STAFF'
        || request.auth.token.role == 'ADMIN';
    }

    function personalMessagingAccount() {
      return request.auth != null &&
        (request.auth.token.email.matches('.*@users[.]olive[.]invalid') ||
          request.auth.token.email.matches('.*@safe[.]olive[.]invalid'));
    }

    function contactAt(c, i) {

      return c.size() <= i || (c[i] is map && c[i].keys().hasOnly(['id','name','phone','details','safeToStay','linkedUid'])

        && c[i].id is string && c[i].id.size() <= 64

        && c[i].name is string && c[i].name.size() > 0 && c[i].name.size() <= 120

        && (!('phone' in c[i]) || (c[i].phone is string && c[i].phone.size() <= 40))

        && (!('safeToStay' in c[i]) || c[i].safeToStay is bool)

        && (!('linkedUid' in c[i]) || (c[i].linkedUid is string && c[i].linkedUid.size() <= 128))

        && c[i].details is string && c[i].details.size() > 0 && c[i].details.size() <= 200);

    }

    function validAddress(a) {

      return a is map && a.keys().hasAll(['line1','line2','city','province','postalCode','country'])

        && a.keys().hasOnly(['line1','line2','city','province','postalCode','country','latitude','longitude'])

        && a.line1 is string && a.line1.size() <= 160

        && a.line2 is string && a.line2.size() <= 160

        && a.city is string && a.city.size() <= 160

        && a.province is string && a.province.size() <= 160

        && a.postalCode is string && a.postalCode.size() <= 160

        && a.country is string && a.country.size() <= 160

        && (!('latitude' in a) || (a.latitude is number && a.latitude >= -90 && a.latitude <= 90))

        && (!('longitude' in a) || (a.longitude is number && a.longitude >= -180 && a.longitude <= 180));

    }

    function validProfile(p) {

      return p.keys().hasAll(['username','fullName','affectedNames','dob','language','situation','region','triggerHash','contacts'])

        && p.keys().hasOnly(['username','fullName','affectedNames','abuserName','dob','language','situation','region','triggerHash','contacts','address','role','coverType','cover_app','email','phone'])

        && p.username is string && p.username.matches('[a-z0-9_]{3,30}')

        && validMessagingEmail(p.username)

        && p.fullName is string && p.fullName.size() > 0 && p.fullName.size() <= 120

        && p.affectedNames is string && p.affectedNames.size() <= 500

        && p.dob is string && p.dob.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')

        && p.language is string && p.language.size() > 0 && p.language.size() <= 60

        && p.situation is string && p.situation.size() <= 2000

        && p.region is string && p.region.size() <= 200

        && p.triggerHash is string
        && (p.triggerHash.matches('[a-f0-9]{64}') || (('role' in p) && p.role in ['SAFE_CONTACT','STAFF','ADMIN'] && p.triggerHash == ''))

        && (!('role' in p) || p.role in ['USER','SAFE_CONTACT','STAFF','ADMIN'])

        && (!('cover_app' in p) || p.cover_app is string)

        && (!('address' in p) || validAddress(p.address))

        && p.contacts is list && p.contacts.size() <= 25

        && contactAt(p.contacts,0) && contactAt(p.contacts,1) && contactAt(p.contacts,2)

        && contactAt(p.contacts,3) && contactAt(p.contacts,4) && contactAt(p.contacts,5)

        && contactAt(p.contacts,6) && contactAt(p.contacts,7) && contactAt(p.contacts,8)

        && contactAt(p.contacts,9) && contactAt(p.contacts,10) && contactAt(p.contacts,11)

        && contactAt(p.contacts,12) && contactAt(p.contacts,13) && contactAt(p.contacts,14)

        && contactAt(p.contacts,15) && contactAt(p.contacts,16) && contactAt(p.contacts,17)

        && contactAt(p.contacts,18) && contactAt(p.contacts,19) && contactAt(p.contacts,20)

        && contactAt(p.contacts,21) && contactAt(p.contacts,22) && contactAt(p.contacts,23)

        && contactAt(p.contacts,24);

    }

    match /users/{uid} {

      allow get: if owner(uid);

      allow list: if false;

      allow create: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.username.matches('[a-z0-9_]{8,24}');

      allow update: if owner(uid) && validProfile(request.resource.data)

        && request.resource.data.username == resource.data.username;

      allow delete: if owner(uid);

    }

    // File access lists can grant reads, but only the authenticated owner can create, edit, or delete metadata.
    // OCR output is payload data. It is permitted only inside encrypted_metadata and never as plaintext fields.
    match /files/{fileId} {
      function validFileMetadata(data, id) {
        return data.keys().hasOnly(['owner_id','storage_path','file_name','file_type','allowed_users','created_at','evidence'])
          && data.owner_id is string
          && data.storage_path == 'users/' + data.owner_id + '/media/' + id
          && data.file_name is string && data.file_name.size() <= 160
          && data.file_type is string && data.file_type.size() <= 120
          && data.allowed_users is list
          && data.allowed_users.size() > 0 && data.allowed_users.size() <= 25
          && data.allowed_users.hasAny([data.owner_id])
          && data.created_at is timestamp
          && (!data.keys().hasAny(['evidence']) || data.evidence is bool);
      }
      function validEncryptedMedia(data, id) {
        return data.keys().hasOnly(['owner_id','object_key','encrypted_metadata','wrapped_keys','device_wrapped_keys','allowed_users',
            'ciphertext_size','ciphertext_sha256','encryption_version','created_at','evidence'])
          && data.owner_id is string
          && data.object_key == 'users/' + data.owner_id + '/media/' + id
          && data.encrypted_metadata is string && data.encrypted_metadata.size() > 0
          && data.encrypted_metadata.size() <= 65536
          && data.wrapped_keys is map
          && (!data.keys().hasAny(['device_wrapped_keys']) || data.device_wrapped_keys is map)
          && data.allowed_users is list
          && data.allowed_users.size() > 0 && data.allowed_users.size() <= 25
          && data.allowed_users.hasAny([data.owner_id])
          && data.wrapped_keys.keys().hasAll(data.allowed_users)
          && data.wrapped_keys.keys().hasOnly(data.allowed_users)
          && data.ciphertext_size is int && data.ciphertext_size > 0
          && data.ciphertext_size <= 250 * 1024 * 1024
          && data.ciphertext_sha256 is string
          && data.ciphertext_sha256.matches('^[0-9a-f]{64}$')
          && data.encryption_version is int && data.encryption_version >= 1
          && data.created_at is timestamp
          && (!data.keys().hasAny(['evidence']) || data.evidence is bool);
      }
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && validFileMetadata(request.resource.data, fileId);
      // A direct document read can validate both authorization and the complete stored shape because
      // Firestore evaluates the rule against one concrete resource.
      allow get: if signedIn() && request.auth.uid in resource.data.allowed_users
        && (validFileMetadata(resource.data, fileId) || validEncryptedMedia(resource.data, fileId));
      // Collection rules are evaluated against every *possible* query result, not only the records
      // currently stored. The Android client constrains this listener with
      // `whereArrayContains("allowed_users", request.auth.uid)`, which proves this membership check.
      // Requiring the full schema validator here makes that safe query unprovable and Firestore rejects
      // it with PERMISSION_DENIED. Schema validation remains mandatory for direct reads and all client
      // writes; callable-created encrypted records are validated before the Admin SDK publishes them.
      allow list: if signedIn() && request.auth.uid in resource.data.allowed_users;
      allow update: if signedIn() && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.storage_path == resource.data.storage_path
        && validFileMetadata(request.resource.data, fileId);
      // Encrypted R2 objects must be deleted through the callable so metadata cannot be orphaned.
      allow delete: if signedIn() && resource.data.owner_id == request.auth.uid
        && resource.data.keys().hasAll(['storage_path']);
    }

    // Account recovery copies are callable-only. Browser and Android clients can obtain one only
    // after the Function checks the signed-in UID against the file's current allowed_users list.
    match /mediaAccessKeys/{fileId} {
      allow read, write: if false;
    }

    // Upload sessions contain internal R2 identifiers and are callable-only.
    match /mediaUploads/{jobId} { allow read, write: if false; }

    match /privateEntries/{entryId} {
      function validPrivateEntry(data) {
        return data.keys().hasOnly(['id','ownerUid','ciphertext','wrappedKeys','allowedUsers','createdAt','updatedAt'])
          && data.id == entryId
          && data.ownerUid is string
          && data.ciphertext is string && data.ciphertext.size() > 0
          && data.wrappedKeys is map
          && data.allowedUsers is list && data.allowedUsers.size() > 0 && data.allowedUsers.size() <= 25
          && data.allowedUsers.hasAny([data.ownerUid])
          && data.wrappedKeys.keys().hasAll(data.allowedUsers)
          && data.wrappedKeys.keys().hasOnly(data.allowedUsers);
      }
      allow read: if signedIn() && request.auth.uid in resource.data.allowedUsers;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid
        && validPrivateEntry(request.resource.data);
      allow update: if signedIn() && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validPrivateEntry(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // Username lookup is exact and case-normalized by the app; listing the directory is never allowed.
    match /messageDirectory/{username} {
      function validDirectoryEntry() {
        return request.resource.data.keys().hasOnly(['uid','username','publicKey','updatedAt'])
          && request.resource.data.username == username
          && request.resource.data.publicKey is string && request.resource.data.publicKey.size() > 0
          && request.resource.data.publicKey.size() <= 1000
          && validMessageUsername(username)
          && validMessagingEmail(username);
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if owner(request.resource.data.uid) && validDirectoryEntry();
      allow update: if owner(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && validDirectoryEntry();
      allow delete: if owner(resource.data.uid);

      // Each phone or browser keeps its own private key and publishes only its wrapping key.
      match /devices/{deviceId} {
        function validMessagingDevice(data) {
          return data.keys().hasOnly(['uid','deviceId','publicKey','platform','mgf1Digest','updatedAt'])
            && data.uid == get(/databases/$(database)/documents/messageDirectory/$(username)).data.uid
            && data.deviceId == deviceId
            && data.deviceId.matches('^[A-Za-z0-9_-]{16,64}$')
            && data.publicKey is string && data.publicKey.size() > 0 && data.publicKey.size() <= 1000
            && data.platform in ['ANDROID','WEB']
            && data.mgf1Digest in ['SHA-1','SHA-256'];
        }
        allow get, list: if signedIn();
        allow create: if owner(request.resource.data.uid) && validMessagingDevice(request.resource.data);
        allow update: if owner(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.deviceId == resource.data.deviceId
          && validMessagingDevice(request.resource.data);
        allow delete: if owner(resource.data.uid);
      }
    }

    function directoryMatches(uid, username) {
      return validMessageUsername(username)
        && get(/databases/$(database)/documents/messageDirectory/$(username)).data.uid == uid;
    }

    function pairIdMatches(pairId, firstUid, secondUid) {
      return pairId == firstUid + '--' + secondUid || pairId == secondUid + '--' + firstUid;
    }

    function validFriendRequest(data) {
      return data.keys().hasOnly(['senderUid','senderUsername','recipientUid','recipientUsername','friendshipId','createdAt'])
        && data.senderUid is string && data.recipientUid is string && data.senderUid != data.recipientUid
        && validMessageUsername(data.senderUsername) && validMessageUsername(data.recipientUsername)
        && pairIdMatches(data.friendshipId,data.senderUid,data.recipientUid)
        && directoryMatches(data.senderUid,data.senderUsername)
        && directoryMatches(data.recipientUid,data.recipientUsername);
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn() && personalMessagingAccount()
        && request.resource.data.senderUid == request.auth.uid
        && requestId == request.resource.data.senderUid + '--' + request.resource.data.recipientUid
        && validFriendRequest(request.resource.data)
        && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.recipientUid + '--' + request.resource.data.senderUid))
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.senderUid + '--' + request.resource.data.recipientUid))
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.recipientUid + '--' + request.resource.data.senderUid));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
    }

    function validFriendship(data, friendshipId) {
      return data.keys().hasOnly(['participantIds','participantUsernames','acceptedRequestId','createdAt'])
        && data.participantIds is list && data.participantIds.size() == 2
        && data.participantIds[0] != data.participantIds[1]
        && data.participantUsernames is map
        && data.participantUsernames[data.participantIds[0]] is string
        && data.participantUsernames[data.participantIds[1]] is string
        && directoryMatches(data.participantIds[0],data.participantUsernames[data.participantIds[0]])
        && directoryMatches(data.participantIds[1],data.participantUsernames[data.participantIds[1]])
        && pairIdMatches(friendshipId,data.participantIds[0],data.participantIds[1]);
    }

    function acceptedRequest(data) {
      return get(/databases/$(database)/documents/friendRequests/$(data.acceptedRequestId)).data;
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow list: if false;
      allow create: if signedIn() && personalMessagingAccount()
        && validFriendship(request.resource.data,friendshipId)
        && acceptedRequest(request.resource.data).recipientUid == request.auth.uid
        && acceptedRequest(request.resource.data).friendshipId == friendshipId
        && acceptedRequest(request.resource.data).senderUid in request.resource.data.participantIds
        && acceptedRequest(request.resource.data).recipientUid in request.resource.data.participantIds
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.participantIds[1] + '--' + request.resource.data.participantIds[0]));
      allow update, delete: if false;
    }

    function friendshipAfter(friendshipId) {
      return getAfter(/databases/$(database)/documents/friendships/$(friendshipId)).data;
    }

    function validFriendListEntry(ownerUid, friendshipId, data) {
      return data.keys().hasOnly(['friendshipId','friendUid','friendUsername','createdAt'])
        && data.friendshipId == friendshipId && data.friendUid != ownerUid
        && ownerUid in friendshipAfter(friendshipId).participantIds
        && data.friendUid in friendshipAfter(friendshipId).participantIds
        && directoryMatches(data.friendUid,data.friendUsername)
        && acceptedRequest(friendshipAfter(friendshipId)).recipientUid == request.auth.uid;
    }

    match /friendLists/{ownerUid}/friends/{friendshipId} {
      allow get, list: if owner(ownerUid);
      allow create: if signedIn() && validFriendListEntry(ownerUid,friendshipId,request.resource.data);
      allow update, delete: if false;
    }

    // Safe contacts explicitly share only their saved onboarding location with individual accepted friends.
    match /sharedLocations/{ownerUid}/recipients/{recipientUid} {
      function validSharedLocation(data) {
          return data.keys().hasOnly(['ownerUid','recipientUid','friendshipId','ciphertext','wrappedKey','updatedAt'])
          && data.ownerUid == ownerUid && data.recipientUid == recipientUid && ownerUid != recipientUid
          && data.friendshipId is string
          && exists(/databases/$(database)/documents/friendships/$(data.friendshipId))
          && ownerUid in get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data.participantIds
          && recipientUid in get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data.participantIds
            && data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 4000
            && data.wrappedKey is string && data.wrappedKey.size() > 0 && data.wrappedKey.size() <= 1000
          && data.updatedAt is timestamp;
      }
      allow get: if signedIn() && (request.auth.uid == ownerUid || request.auth.uid == recipientUid);
      allow list: if owner(ownerUid);
      allow create, update: if owner(ownerUid) && validSharedLocation(request.resource.data);
      allow delete: if owner(ownerUid);
    }

    // Presence records let an authorized contact begin listening before the first live coordinate arrives.
    match /liveLocationShares/{ownerUid}/recipients/{recipientUid} {
      function validLiveShare(data) {
          return data.keys().hasOnly(['ownerUid','recipientUid','friendshipId','wrappedKey','createdAt'])
          && data.ownerUid == ownerUid && data.recipientUid == recipientUid && ownerUid != recipientUid
          && data.friendshipId is string
          && exists(/databases/$(database)/documents/friendships/$(data.friendshipId))
          && ownerUid in get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data.participantIds
          && recipientUid in get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data.participantIds
            && data.wrappedKey is string && data.wrappedKey.size() > 0 && data.wrappedKey.size() <= 1000
          && data.createdAt is timestamp;
      }
      allow get: if signedIn() && (request.auth.uid == ownerUid || request.auth.uid == recipientUid);
      allow list: if owner(ownerUid);
      allow create, update: if owner(ownerUid) && validLiveShare(request.resource.data);
      allow delete: if owner(ownerUid);
    }

    function conversationParticipant(data) {
      return signedIn() && data.participantIds is list && request.auth.uid in data.participantIds;
    }

    function friendshipForConversation(data) {
      return getAfter(/databases/$(database)/documents/friendships/$(data.friendshipId)).data;
    }

    function validSupportAdmin(data) {
      return (!data.keys().hasAny(['adminUid']) && data.participantIds.size() <= 3)
        || (data.keys().hasAny(['adminUid']) && data.adminUid is string
          && ((data.adminUid == '' && data.participantIds.size() <= 3)
            || (data.adminUid != '' && data.adminUid in data.participantIds)));
    }

    function validConversation(data, conversationId) {
      return data.keys().hasOnly(['type','ownerUid','staffUid','adminUid','supportOrigin','supportTag','closedAt','friendshipId','participantIds','participantUsernames','createdAt','updatedAt','lastMessage','lastMessageId','lastSenderUid','roomKeys','participantPublicKeys'])
        && data.friendshipId == conversationId
        && data.lastMessage is string && data.lastMessage.size() <= 160
        && data.lastMessageId is string && data.lastMessageId.size() <= 128
        && (!data.keys().hasAny(['lastSenderUid'])
          || (data.lastSenderUid is string && data.lastSenderUid.size() <= 128))
        && ((!(data.keys().hasAny(['type']))
              && existsAfter(/databases/$(database)/documents/friendships/$(data.friendshipId))
              && data.participantIds == friendshipForConversation(data).participantIds
              && data.participantUsernames == friendshipForConversation(data).participantUsernames)
          || (data.type == 'SUPPORT' && data.ownerUid is string && data.staffUid is string
              && (!data.keys().hasAny(['closedAt']) || data.closedAt is timestamp)
              && data.supportOrigin in ['PLAN_CONSULT', 'SUPPORT']
              && data.supportTag in ['PLAN_CONSULT', 'SUPPORT', 'NEEDS_ADMIN']
              && conversationId.matches('^' + (data.supportOrigin == 'PLAN_CONSULT' ? 'plan-consult-' : 'support-')
                + data.ownerUid + '(-[A-Za-z0-9_-]{1,64})?$')
              && data.participantIds is list && data.participantIds.size() >= 2
              && data.participantIds.size() <= 4 && data.ownerUid in data.participantIds
              && data.staffUid in data.participantIds
              && validSupportAdmin(data)));
    }

    function validAdditionalConversationKeys(data) {
      return data.participantIds.size() == 2
        || (data.participantIds.size() >= 3
          && data.roomKeys[data.participantIds[2]] is string
          && data.roomKeys[data.participantIds[2]].size() <= 1000
          && data.participantPublicKeys[data.participantIds[2]] == get(/databases/$(database)/documents/messageDirectory/$(data.participantUsernames[data.participantIds[2]])).data.publicKey
          && (data.participantIds.size() == 3
            || (data.participantIds.size() == 4
              && data.roomKeys[data.participantIds[3]] is string
              && data.roomKeys[data.participantIds[3]].size() <= 1000
              && data.participantPublicKeys[data.participantIds[3]] == get(/databases/$(database)/documents/messageDirectory/$(data.participantUsernames[data.participantIds[3]])).data.publicKey)));
    }

    function validConversationKeys(data) {
      return data.roomKeys is map && data.participantPublicKeys is map
        && data.roomKeys.keys().hasAll(data.participantIds) && data.roomKeys.keys().hasOnly(data.participantIds)
        && data.participantPublicKeys.keys().hasAll(data.participantIds)
        && data.participantPublicKeys.keys().hasOnly(data.participantIds)
        && data.roomKeys[data.participantIds[0]] is string && data.roomKeys[data.participantIds[0]].size() <= 1000
        && data.roomKeys[data.participantIds[1]] is string && data.roomKeys[data.participantIds[1]].size() <= 1000
        && data.participantPublicKeys[data.participantIds[0]] == get(/databases/$(database)/documents/messageDirectory/$(data.participantUsernames[data.participantIds[0]])).data.publicKey
        && data.participantPublicKeys[data.participantIds[1]] == get(/databases/$(database)/documents/messageDirectory/$(data.participantUsernames[data.participantIds[1]])).data.publicKey
        && validAdditionalConversationKeys(data);
    }

    match /conversations/{conversationId} {
      // Collection listeners must constrain participantIds to the authenticated UID.
      // Firestore rejects unfiltered and other-user queries because it cannot prove this predicate.
      allow get: if conversationParticipant(resource.data)
        || (signedIn()
          && exists(/databases/$(database)/documents/friendships/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(conversationId)).data.participantIds);
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if conversationParticipant(request.resource.data)
        && !request.resource.data.keys().hasAny(['type'])
        && validConversation(request.resource.data,conversationId);
      allow update: if conversationParticipant(resource.data)
        && validConversation(request.resource.data,conversationId)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageId','lastSenderUid','updatedAt'])
          || (!resource.data.keys().hasAny(['roomKeys','participantPublicKeys'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomKeys','participantPublicKeys','updatedAt'])
            && validConversationKeys(request.resource.data))
          || (resource.data.keys().hasAll(['roomKeys','participantPublicKeys'])
            && resource.data.participantPublicKeys != request.resource.data.participantPublicKeys
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomKeys','participantPublicKeys','updatedAt'])
            && validConversationKeys(request.resource.data))
        );
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if conversationParticipant(parentConversation());
        allow create: if conversationParticipant(parentConversation())
          && request.resource.data.keys().hasOnly(['senderUid','senderUsername','body','ciphertext','deleted','sentAt','clientSentAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUsername is string
          && request.resource.data.senderUsername == parentConversation().participantUsernames[request.auth.uid]
            && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() > 0
            && request.resource.data.ciphertext.size() <= 12000
            && !request.resource.data.keys().hasAny(['body'])
          && request.resource.data.deleted == false
          && request.resource.data.clientSentAt is int;
        allow update: if conversationParticipant(parentConversation())
          && resource.data.senderUid == request.auth.uid
          && resource.data.deleted == false && request.resource.data.deleted == true
          && ((!resource.data.keys().hasAny(['ciphertext']) && request.resource.data.body == 'Message unsent')
            || (resource.data.keys().hasAny(['ciphertext']) && request.resource.data.ciphertext == 'Message unsent'))
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.senderUsername == resource.data.senderUsername
          && request.resource.data.sentAt == resource.data.sentAt
          && request.resource.data.clientSentAt == resource.data.clientSentAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','ciphertext','deleted','deletedAt']);
        allow delete: if false;
      }

      // Conversation participants may wrap the same room key for another registered device.
      match /deviceKeys/{deviceKeyId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function validDeviceRoomKey(data) {
          return data.keys().hasOnly(['uid','deviceId','publicKey','wrappedKey','updatedAt'])
            && data.uid in parentConversation().participantIds
            && deviceKeyId == data.uid + '--' + data.deviceId
            && data.wrappedKey is string && data.wrappedKey.size() > 0 && data.wrappedKey.size() <= 1000;
        }
        function registeredDeviceMatches(data) {
          return data.publicKey == get(/databases/$(database)/documents/messageDirectory/$(parentConversation().participantUsernames[data.uid])/devices/$(data.deviceId)).data.publicKey;
        }
        allow read: if conversationParticipant(parentConversation());
        allow create, update: if conversationParticipant(parentConversation())
          && validDeviceRoomKey(request.resource.data)
          && registeredDeviceMatches(request.resource.data);
        allow delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }

  }

}

