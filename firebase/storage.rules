rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Change this path with AccountRepository.profileObject; keep every profile locked to its owner.
    match /accounts/{uid}/profile.json {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.size <= 64 * 1024
        && request.resource.contentType == 'application/json';
      allow delete: if owner(uid);
    }

    // Each account owns its activity history plus private notes and incident records.
    match /accounts/{uid}/history/{kind}/{entry} {
      allow read: if owner(uid) && kind in ['settings', 'triggers', 'checkouts', 'private_entries'];
      allow create, update: if owner(uid)
        && kind in ['settings', 'triggers', 'checkouts', 'private_entries']
        && entry.matches('[A-Za-z0-9-]{8,64}\\.json')
        && ((kind == 'private_entries' && request.resource.size <= 5 * 1024 * 1024)
          || (kind != 'private_entries' && request.resource.size <= 64 * 1024))
        && request.resource.contentType == 'application/json';
      allow delete: if owner(uid) && kind in ['settings', 'triggers', 'checkouts', 'private_entries'];
    }

    // Raw Media: Only the exact user who owns the folder can read or write inside it
    match /users/{userId}/media/{fileName} {
      allow read, write: if owner(userId);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
