{
  "name": "olive-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,database,storage --project demo-olive-rules --config emulator.json \"npm run test:cases\"",
    "test:all": "firebase emulators:exec --only firestore,database,storage --project demo-olive-rules --config emulator.json \"npm run test:cases -- ../functions/opaqueRecovery.emulator.test.js\"",
    "pretest:cases": "node -e \"require('node:fs').mkdirSync('../build/reports', {recursive: true})\"",
    "test:cases": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../build/reports/firebase-rules-tests.xml rules.test.mjs storage.rules.test.mjs safety-plans.test.mjs friend-invites.test.mjs",
    "test:opaque-functions": "firebase emulators:exec --only firestore --project demo-olive-rules --config emulator.json \"node --test ../functions/opaqueRecovery.emulator.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1"
  }
}
