# Public WebAuthn relying-party configuration. Never use wildcards.
WEBAUTHN_RP_ID=yourolivebranch.ca
WEBAUTHN_ORIGINS=https://yourolivebranch.ca

# Production release signer published in /.well-known/assetlinks.json.
WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:LW7h8ZXtRkHe5yILPktcq4SN3ME7veqR6f6kp2kRLmY

# A debug-only Firebase project should replace the value above with:
# WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:OFitv0cEN20w0aE2i8QQuzhYV9lnBm3Qh0vKhkhxuN0

# Hostinger SMTP email notification configuration (set SMTP_PASS via: firebase functions:secrets:set SMTP_PASS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=donotreply@yourolivebranch.ca
EMAIL_FROM=Olive Branch <donotreply@yourolivebranch.ca>
