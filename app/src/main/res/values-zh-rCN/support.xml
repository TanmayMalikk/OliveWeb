    <string name="walkthrough_topic_cover_title">伪装应用与秘密入口</string>
    <string name="walkthrough_topic_cover_summary">将 Olive Branch 伪装为每日摘要或健身追踪器，并通过秘密触发词或隐藏橄榄图标进入。</string>
    <string name="walkthrough_topic_cover_step_1">在“设置”中选择“每日摘要”或“健身追踪器”，桌面图标和应用名称会随之切换。</string>
    <string name="walkthrough_topic_cover_step_2">在伪装页搜索栏输入秘密触发短语，或在伪装页“账户”页面双击小橄榄图标。</string>
    <string name="walkthrough_topic_cover_step_3">通过 4–6 位应用 PIN 码或 Android 设备锁验证，即可解锁您的安全空间。</string>
    <string name="walkthrough_topic_cover_demo">练习输入示例触发短语“moon garden”或双击隐藏橄榄图标来体验秘密进入流程。</string>
    <string name="walkthrough_topic_exit_title">快速退出与自动锁定</string>
    <string name="walkthrough_topic_exit_summary">随时一键返回伪装应用，或在无操作与切到后台时自动锁定私密空间。</string>
    <string name="walkthrough_topic_exit_step_1">在任意私密页面点击角落的“快速退出”悬浮按钮，立即返回伪装应用。</string>
    <string name="walkthrough_topic_exit_step_2">切换应用或关闭屏幕时，安全空间会自动锁定。</string>
    <string name="walkthrough_topic_exit_step_3">在“设置 → 隐私”中调整闲置自动锁定时间及防截屏保护。</string>
    <string name="walkthrough_topic_exit_demo">模拟点击“快速退出”，查看私密工作区如何立即清除并返回伪装界面。</string>
    <string name="walkthrough_topic_plan_title">安全计划</string>
    <string name="walkthrough_topic_plan_summary">制定主计划与备用清单、支持离线保存、与信任联系人共享或请求工作人员咨询。</string>
    <string name="walkthrough_topic_plan_step_1">查看并编辑根据引导问卷生成的首选计划、备用步骤和紧急随身物品清单。</string>
    <string name="walkthrough_topic_plan_step_2">修改会立即保存在本地，并在恢复联网后自动同步。</string>
    <string name="walkthrough_topic_plan_step_3">将安全计划共享给已接受的好友（可随时撤销），或点击请求工作人员咨询。</string>
    <string name="walkthrough_topic_plan_demo">练习勾选紧急随身物品清单并预览安全计划共享权限。</string>
    <string name="walkthrough_topic_notes_title">笔记与事件记录</string>
    <string name="walkthrough_topic_notes_summary">记录私密笔记及带日期、GPS/地图位置、附件、置顶和编辑历史的事件档案。</string>
    <string name="walkthrough_topic_notes_step_1">创建普通“笔记”或记录包含日期、时间、位置及加密附件的“事件”。</string>
    <string name="walkthrough_topic_notes_step_2">将重要记录置顶、按笔记或事件筛选，并通过关键词搜索。</string>
    <string name="walkthrough_topic_notes_step_3">查看每条记录的修改历史、共享给信任联系人或从回收站恢复。</string>
    <string name="walkthrough_topic_notes_demo">在沙盒中练习置顶事件记录并查看带时间戳的修改历史。</string>
    <string name="walkthrough_topic_docs_title">加密文档、相机与 OCR 识别</string>
    <string name="walkthrough_topic_docs_summary">存储端到端加密文件、使用应用内相机拍摄、通过本地 OCR 提取文字并安全共享。</string>
    <string name="walkthrough_topic_docs_step_1">上传 PDF、照片、视频或音频，所有文件在上传前均在本地完成加密。</string>
    <string name="walkthrough_topic_docs_step_2">使用应用内相机直接拍摄证据并加密保存，不会留存在系统公共相册中。</string>
    <string name="walkthrough_topic_docs_step_3">运行本地 OCR 识别图片中的文字并校对保存，随后将所选文件共享给联系人。</string>
    <string name="walkthrough_topic_docs_demo">模拟对文档进行本地加密并运行设备端 OCR 文字提取。</string>
    <string name="walkthrough_topic_chat_title">好友、消息、语音与通话</string>
    <string name="walkthrough_topic_chat_summary">通过好友请求或 48 小时邀请码连接，发送加密消息与仅限聊天的语音，或拨打加密电话。</string>
    <string name="walkthrough_topic_chat_step_1">通过用户名搜索添加信任的人，或生成 48 小时有效的一次性邀请码/链接。</string>
    <string name="walkthrough_topic_chat_step_2">在单聊或群聊中发送加密文字、仅在聊天中保存的语音消息、附件、笔记、安全计划或实时位置。</string>
    <string name="walkthrough_topic_chat_step_3">发起加密语音通话、搜索聊天记录、撤回消息，或打开“聊天信息”查看成员与共享内容。</string>
    <string name="walkthrough_topic_chat_demo">练习生成 48 小时示例邀请码并发送沙盒加密语音消息。</string>
    <string name="walkthrough_topic_location_title">实时位置与导航</string>
    <string name="walkthrough_topic_location_summary">向指定联系人共享实时位置、查看他人共享给您的位置并获取路线导航。</string>
    <string name="walkthrough_topic_location_step_1">打开位置地图查看当前定位及已保存的地点目录。</string>
    <string name="walkthrough_topic_location_step_2">向选定联系人开启指定时长的实时位置共享，并可随时增删接收人或停止共享。</string>
    <string name="walkthrough_topic_location_step_3">选择正在共享位置的联系人或搜索目的地，开启分段路线导航。</string>
    <string name="walkthrough_topic_location_demo">练习开启和停止与信任联系人的模拟实时位置共享。</string>
    <string name="walkthrough_topic_staff_title">工作人员协助与支持工单</string>
    <string name="walkthrough_topic_staff_summary">在带工单编号的支持对话中联系机构工作人员，或将现有聊天升级为工作人员支持。</string>
    <string name="walkthrough_topic_staff_step_1">打开底部支持菜单（+）并点击“请求工作人员协助”，或在现有对话中发起申请。</string>
    <string name="walkthrough_topic_staff_step_2">等待系统分配在线工作人员（分配完成前可随时取消申请）。</string>
    <string name="walkthrough_topic_staff_step_3">与工作人员沟通、共享相关笔记或计划，并可按需将已接受的好友加入支持工单。</string>
    <string name="walkthrough_topic_staff_demo">模拟发起支持工单申请并预览工作人员分配状态。</string>
    <string name="walkthrough_topic_emergency_title">紧急报告 PDF</string>
    <string name="walkthrough_topic_emergency_summary">生成包含个人资料、事件记录和 GPS 坐标的加密紧急 PDF 报告，并向机构管理员发出警报。</string>
    <string name="walkthrough_topic_emergency_step_1">在安全空间的支持菜单（+）中点击“紧急求助”，或在伪装页长按橄榄图标 2 秒。</string>
    <string name="walkthrough_topic_emergency_step_2">Olive Branch 会将您的资料、事件记录与当前坐标打包为加密 PDF 并存入“文档”。</string>
    <string name="walkthrough_topic_emergency_step_3">联网状态下，机构管理员会收到紧急警报，并可查看报告 PDF 与实时地图位置。</string>
    <string name="walkthrough_topic_emergency_demo">预览示例紧急报告 PDF 包含的内容模块，不会发送真实警报。</string>
    <string name="walkthrough_topic_hotlines_title">援助热线与信任联系人</string>
    <string name="walkthrough_topic_hotlines_summary">按地区浏览加拿大援助热线、庇护所和法律援助，并管理您的信任安全联系人名录。</string>
    <string name="walkthrough_topic_hotlines_step_1">打开“热线资源”，按省份和城市筛选 24/7 危机热线、庇护所、法律援助与心理咨询。</string>
    <string name="walkthrough_topic_hotlines_step_2">点击心形图标收藏重要服务、一键拨号，或在地图上查看目录地点并导航。</string>
    <string name="walkthrough_topic_hotlines_step_3">在“信任联系人”中记录关系说明、标记是否可安全借宿，并关联聊天好友。</string>
    <string name="walkthrough_topic_hotlines_demo">练习收藏一条 24/7 危机热线并将示例联系人标记为“可安全借宿”。</string>
    <string name="walkthrough_topic_activity_title">活动历史、通行密钥与设置</string>
    <string name="walkthrough_topic_activity_summary">查看安全审计日志、注册 Passkey 账户恢复密钥并管理应用权限。</string>
    <string name="walkthrough_topic_activity_step_1">打开“账户活动”查看带时间戳的设置更改、触发记录、PIN 码尝试与隐私事件。</string>
    <string name="walkthrough_topic_activity_step_2">在“设置 → 隐私”中注册 Passkey 账户恢复密钥，以便在新设备上恢复加密文档与聊天。</string>
    <string name="walkthrough_topic_activity_step_3">在“设置 → 权限”中查看并授权相机、麦克风、位置、通知和健康数据权限。</string>
    <string name="walkthrough_topic_activity_demo">预览示例安全审计日志条目与 Passkey 恢复密钥启用状态。</string>
</resources>
