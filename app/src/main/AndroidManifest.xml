<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Olive branch tracks user location at all time as part of our core safety features.
    While users can choose not to use it, it is part of our Requirements per our contract.
    This gives user's safety functionality
     Warning suppressed.-->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="BackgroundLocationPolicy" />
    <!-- This warning is being suppressed, since that's the only way to handle it, the warning is meant to serve
    as a stop gap to slow the developer and make them think about their actions.
    Our use case for FOREGROUND_SERVICE is to be able to do location/calling-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full screen intent is being used in our project to notify users of incoming phone calls,
    The warning is to notify the developers that there are tight best practice considerations,
    and to not abuse the powers it gives.
    In our app the only full screen intent calls happen while the app is open to act as a mimicry of
    the screen that pops up when you get a normal phone call.
    Warning suppressed -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="FullScreenIntentPolicy" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Release APKs are distributed from Olive's website. Android still asks the user to
         approve Olive as an installation source before an update can be installed.
          Warning suppressed.-->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:name=".OliveApplication" android:allowBackup="false" android:label="@string/app_name"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_app_info_blank" android:roundIcon="@drawable/ic_app_info_blank"
        android:supportsRtl="true" android:theme="@style/Theme.Olive">
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- OCR runs locally. Disable ONNX's optional telemetry provider, which eagerly loads
             native code and calls telemetry JNI methods absent from the Android artifact. -->
        <!--The android:Authorities tag should not be needed, for some reason I get an error
         when the authorities tag is not present even though the gradle build performs.
         A linter error?-->
        <provider android:name="ai.onnxruntime.TelemetryInitializer" tools:node="remove"
            android:authorities="ThisShouldNotBeHere" />
        <service
            android:name=".data.messaging.OliveFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".data.messaging.VoipCallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
        <service android:name=".location.LiveLocationService" android:exported="false"
            android:foregroundServiceType="location" android:stopWithTask="false" />
        <service android:name=".location.AdminLocationService" android:exported="false"
            android:foregroundServiceType="location" android:stopWithTask="false" />
        <service
            android:name=".ui.covers.fitness.FitnessWorkoutService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <service
            android:name=".ui.covers.fitness.FitnessWatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/olive/fitness/watch-activity" />
            </intent-filter>
        </service>
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.documents" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/document_paths" />
        </provider>
        <activity android:name=".OliveActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".data.update.AppUpdateInstallerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Olive" />
        <!-- Android Studio can always use this entry point, even after the user changes covers. -->
        <activity android:name=".OliveLauncher" android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias android:name=".GameLauncher" android:targetActivity=".OliveActivity"
            android:exported="true" android:enabled="false" android:label="Olive Games"
            android:icon="@mipmap/ic_launcher_game" android:roundIcon="@mipmap/ic_launcher_game">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".NewsLauncher" android:targetActivity=".OliveActivity"
            android:exported="true" android:enabled="false" android:label="Daily Digest"
            android:icon="@mipmap/ic_launcher_news" android:roundIcon="@mipmap/ic_launcher_news">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".FitnessLauncher" android:targetActivity=".OliveActivity"
            android:exported="true" android:enabled="true" android:label="Fitness Tracker"
            android:icon="@mipmap/ic_launcher_fitness" android:roundIcon="@mipmap/ic_launcher_fitness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".BranchLauncher" android:targetActivity=".OliveActivity"
            android:exported="true" android:enabled="false" android:label="Olive Branch"
            android:icon="@mipmap/ic_launcher_branch" android:roundIcon="@mipmap/ic_launcher_branch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".TreeLauncher" android:targetActivity=".OliveActivity"
            android:exported="true" android:enabled="false" android:label="Olive Tree"
            android:icon="@mipmap/ic_launcher_tree" android:roundIcon="@mipmap/ic_launcher_tree">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
