<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only launcher. It is merged into debug builds only and never into a release APK. -->
        <activity
            android:name=".debug.PasskeyPrfProbeActivity"
            android:exported="true"
            android:label="Olive PRF Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".debug.DebugVoipTokenReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.olive.app.debug.ROTATE_VOIP_TOKEN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
